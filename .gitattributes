# Git LFS (optional — install with: brew install git-lfs && git lfs install)
# Uncomment after installing git-lfs, then run: git lfs track "highlights/**/*.mp3" "highlights/**/*.png"
#
# highlights/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
# highlights/**/*.png filter=lfs diff=lfs merge=lfs -text

# Normalize line endings for text files
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
