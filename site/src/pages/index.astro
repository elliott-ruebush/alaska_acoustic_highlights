---
import BaseLayout from "../layouts/BaseLayout.astro";
import CategoryBadge from "../components/CategoryBadge.astro";
import ClipDuration from "../components/ClipDuration.astro";
import { buildClipSearchText, getAllClips, getCardLinkDescription, getCategories, getLocationLabel, getParks } from "../lib/catalog";
import { withBase } from "../lib/paths";

const clips = getAllClips();
const categories = getCategories();
const parks = getParks();
---

<BaseLayout>
  <section class="hero">
    <h1>Soundscapes of Alaska</h1>
    <p class="lead">
      A searchable library of soundscape recordings from Alaska National Parks. These highlights were selected and labeled by Halyn Betchkal with the National Park Service. Special thanks to Halyn for making this site possible!
    </p>
    <p class="lead">
      Continue on to hear howling wolves, surging glaciers, chorusing birds, and more—each paired with a spectrogram.
    </p>
    <p class="lead">
      Learn more on the <a href={withBase("about/")}>About page (data collection and spectrograms)</a>.
    </p>
  </section>

  <section
    id="filters"
    class="filters"
    aria-labelledby="filters-heading"
    aria-controls="recordings-grid"
  >
    <div class="filters-header">
      <h2 id="filters-heading" class="filters-heading">Filter recordings</h2>
      <button type="button" id="clear-filters" class="btn btn--secondary btn--small" hidden>
        Clear all filters
      </button>
    </div>

    <div class="filter-row chips">
      <span id="category-label" class="filter-label">Category</span>
      <div class="chip-group" role="radiogroup" aria-labelledby="category-label">
        <button
          type="button"
          class="chip"
          role="radio"
          data-category="all"
          data-active="true"
          aria-checked="true"
          tabindex="0"
        >
          All ({clips.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="chip"
            role="radio"
            data-category={cat.name}
            data-active="false"
            aria-checked="false"
            tabindex="-1"
          >
            {cat.name} ({cat.count})
          </button>
        ))}
      </div>
    </div>

    <div class="filter-row">
      <label for="park-filter">Park</label>
      <select id="park-filter">
        <option value="all">All parks ({clips.length})</option>
        {parks.map((park) => (
          <option value={park.code} data-park-name={park.name}>
            {park.name} ({park.code}) ({park.count})
          </option>
        ))}
      </select>
    </div>

    <div class="filter-row filter-row--search">
      <label for="search-filter">Search</label>
      <div class="search-field">
        <input
          id="search-filter"
          type="search"
          placeholder="Search titles, parks, sites, descriptions…"
          autocomplete="off"
          aria-describedby="search-hint"
        />
        <p id="search-hint" class="filter-hint">
          Matches title, park, site, and description.
        </p>
      </div>
    </div>
  </section>

  <p id="filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <p id="empty-state" class="empty-state" hidden>No recordings match your filters.</p>

  <section id="recordings-grid" class="grid" aria-label="Recordings">
    {clips.map((clip) => (
      <a
        href={withBase(`clips/${clip.id}/`)}
        class="card"
        aria-labelledby={`card-title-${clip.id}`}
        aria-describedby={`card-desc-${clip.id}`}
        data-category={clip.category}
        data-park={clip.park_code ?? "unknown"}
        data-search={buildClipSearchText(clip)}
      >
        <img
          src={withBase(clip.spectrogram_path)}
          alt=""
          loading="lazy"
          width="1200"
          height="400"
        />
        <div class="card-body">
          <h2 id={`card-title-${clip.id}`}>{clip.title}</h2>
          <p id={`card-desc-${clip.id}`} class="sr-only">
            {getCardLinkDescription(clip)}
          </p>
          <div class="card-meta" aria-hidden="true">
            <CategoryBadge category={clip.category} />
            <p class="meta">
              <span>{getLocationLabel(clip)}</span>
              <span> · </span>
              <ClipDuration durationSec={clip.duration_sec} />
            </p>
          </div>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<script>
  import { initGalleryFilters } from "../lib/filterController";

  initGalleryFilters();
</script>

<style>
  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--color-forest);
  }

  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    color: var(--color-muted);
    max-width: 60ch;
  }

  .filters {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.55);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .filters-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .filters-heading {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-forest);
  }

  .btn--small {
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .filter-row label,
  .filter-label {
    font-weight: 600;
    min-width: 4.5rem;
    color: var(--color-brown-dark);
  }

  .filter-row--search {
    align-items: flex-start;
  }

  .search-field {
    flex: 1;
    min-width: 200px;
  }

  .filter-hint {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .chips {
    gap: 0.5rem;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    border: 1px solid #c4b8a8;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .chip[data-active="true"] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }

  select,
  input[type="search"] {
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1px solid #c4b8a8;
    border-radius: var(--radius);
    font: inherit;
    background: var(--color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card.is-hidden,
  .card[hidden] {
    display: none !important;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }

  .card img {
    width: 100%;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    background: #1a1a1a;
  }

  .card-body {
    padding: 0.85rem 1rem 1rem;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .meta {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: 2rem 0;
  }
</style>
