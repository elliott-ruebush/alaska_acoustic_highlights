---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllClips, getCategories, getParks } from "../lib/catalog";
import { formatDuration, categorySlug } from "../lib/format";
import { withBase } from "../lib/paths";

const clips = getAllClips();
const categories = getCategories();
const parks = getParks();
---

<BaseLayout>
  <section class="hero">
    <h1>Soundscapes of Alaska</h1>
    <p class="lead">
      A searchable library of NPS soundscape recordings from Alaska. Howling wolves, glacier surges,
      bird choruses, and more, each paired with a spectrogram to visualize the audio.
    </p>
  </section>

  <section class="filters" aria-label="Filter clips">
    <div class="filter-row chips" role="group" aria-label="Category">
      <button type="button" class="chip" data-category="all" data-active="true" aria-pressed="true">All ({clips.length})</button>
      {categories.map((cat) => (
        <button type="button" class="chip" data-category={cat.name} data-active="false" aria-pressed="false">
          {cat.name} ({cat.count})
        </button>
      ))}
    </div>

    <div class="filter-row">
      <label for="park-filter">Park</label>
      <select id="park-filter">
        <option value="all">All parks ({clips.length})</option>
        {parks.map((park) => (
          <option value={park.code} data-park-name={park.name}>
            {park.name} ({park.code}) ({park.count})
          </option>
        ))}
      </select>
    </div>

    <div class="filter-row">
      <label for="search-filter">Search</label>
      <input
        id="search-filter"
        type="search"
        placeholder="Search titles, parks, sites, descriptions…"
        autocomplete="off"
      />
    </div>
  </section>

  <p id="filter-status" class="sr-only" aria-live="polite" aria-atomic="true"></p>

  <p id="empty-state" class="empty-state" hidden>No clips match your filters.</p>

  <section class="grid" aria-label="Clip gallery">
    {clips.map((clip) => (
      <a
        href={withBase(`clips/${clip.id}/`)}
        class="card"
        data-category={clip.category}
        data-park={clip.park_code ?? "unknown"}
        data-search={[clip.title, clip.description, clip.park_code, clip.site_code, clip.category, clip.id]
          .filter(Boolean)
          .join(" ")
          .toLowerCase()}
      >
        <img
          src={withBase(clip.spectrogram_path)}
          alt={clip.description}
          loading="lazy"
          width="1200"
          height="400"
        />
        <div class="card-body">
          <h2>{clip.title}</h2>
          <span class={`badge badge--${categorySlug(clip.category)}`}>{clip.category}</span>
          <p class="meta">
            {[clip.park_code, clip.site_code].filter(Boolean).join(" · ") || "Unknown park"}
            <span aria-hidden="true"> · </span>
            <span>{formatDuration(clip.duration_sec)}</span>
          </p>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<script>
  const chips = document.querySelectorAll(".chip");
  const parkSelect = document.querySelector("#park-filter");
  const searchInput = document.querySelector("#search-filter");
  const cards = document.querySelectorAll(".card");
  const emptyState = document.querySelector("#empty-state");
  const filterStatus = document.querySelector("#filter-status");

  const PARAM_CATEGORY = "category";
  const PARAM_PARK = "park";
  const PARAM_SEARCH = "q";
  const totalClips = cards.length;

  const validCategories = new Set(
    [...chips].map((chip) => chip.getAttribute("data-category") ?? "all"),
  );
  const validParks = new Set(
    [...parkSelect.options].map((option) => option.value),
  );

  let activeCategory = "all";
  let searchDebounce: ReturnType<typeof setTimeout> | undefined;
  let announceDebounce: ReturnType<typeof setTimeout> | undefined;

  function setChipActiveState(category: string) {
    chips.forEach((chip) => {
      const chipCategory = chip.getAttribute("data-category") ?? "all";
      const isActive = chipCategory === category;
      chip.setAttribute("data-active", isActive ? "true" : "false");
      chip.setAttribute("aria-pressed", isActive ? "true" : "false");
    });
  }

  function announceFilterResults(visible: number) {
    if (!filterStatus) return;
    filterStatus.textContent =
      visible === 0
        ? "No clips match your filters."
        : `Showing ${visible} of ${totalClips} clips.`;
  }

  function scheduleFilterAnnouncement(visible: number) {
    clearTimeout(announceDebounce);
    announceDebounce = setTimeout(() => announceFilterResults(visible), 300);
  }

  function readFiltersFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const category = params.get(PARAM_CATEGORY) ?? "all";
    const park = params.get(PARAM_PARK) ?? "all";
    return {
      category: validCategories.has(category) ? category : "all",
      park: validParks.has(park) ? park : "all",
      search: params.get(PARAM_SEARCH) ?? "",
    };
  }

  function syncUiFromState(category: string, park: string, search: string) {
    activeCategory = category;
    setChipActiveState(category);
    parkSelect.value = park;
    if (searchInput.value !== search) {
      searchInput.value = search;
    }
  }

  function buildUrl(category: string, park: string, search: string) {
    const params = new URLSearchParams();
    if (category !== "all") params.set(PARAM_CATEGORY, category);
    if (park !== "all") params.set(PARAM_PARK, park);
    const trimmed = search.trim();
    if (trimmed) params.set(PARAM_SEARCH, trimmed);
    const qs = params.toString();
    return qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
  }

  function updateUrl(mode: "push" | "replace") {
    const url = buildUrl(activeCategory, parkSelect.value, searchInput.value);
    if (mode === "replace") {
      history.replaceState(null, "", url);
    } else {
      history.pushState(null, "", url);
    }
  }

  function cardMatchesCategoryAndSearch(
    card: Element,
    category: string,
    query: string,
  ): boolean {
    const cardCategory = card.getAttribute("data-category") ?? "";
    const searchText = card.getAttribute("data-search") ?? "";
    return (
      (category === "all" || cardCategory === category) &&
      (!query || searchText.includes(query))
    );
  }

  function updateParkCounts() {
    const query = searchInput.value.trim().toLowerCase();
    const counts = new Map<string, number>();
    let total = 0;

    cards.forEach((card) => {
      if (!cardMatchesCategoryAndSearch(card, activeCategory, query)) return;
      total++;
      const code = card.getAttribute("data-park");
      if (code && code !== "unknown") {
        counts.set(code, (counts.get(code) ?? 0) + 1);
      }
    });

    [...parkSelect.options].forEach((option) => {
      if (option.value === "all") {
        option.textContent = `All parks (${total})`;
        return;
      }
      const code = option.value;
      const name = option.dataset.parkName ?? code;
      const count = counts.get(code) ?? 0;
      option.textContent = `${name} (${code}) (${count})`;
      option.disabled = count === 0;
    });

    const selected = parkSelect.value;
    if (selected !== "all" && (counts.get(selected) ?? 0) === 0) {
      parkSelect.value = "all";
    }
  }

  function applyFilters(announce: "now" | "debounce" | "none" = "now") {
    const query = searchInput.value.trim().toLowerCase();
    updateParkCounts();

    const park = parkSelect.value;
    let visible = 0;

    cards.forEach((card) => {
      const cardPark = card.getAttribute("data-park") ?? "";

      const show =
        cardMatchesCategoryAndSearch(card, activeCategory, query) &&
        (park === "all" || cardPark === park);

      card.classList.toggle("is-hidden", !show);
      if (show) visible++;
    });

    emptyState.hidden = visible > 0;

    if (announce === "now") {
      announceFilterResults(visible);
    } else if (announce === "debounce") {
      scheduleFilterAnnouncement(visible);
    }

    return visible;
  }

  function setFiltersFromUrl(updateHistory: "push" | "replace" | "none") {
    const { category, park, search } = readFiltersFromUrl();
    syncUiFromState(category, park, search);
    applyFilters();
    if (updateHistory !== "none") {
      updateUrl(updateHistory);
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      activeCategory = chip.getAttribute("data-category") ?? "all";
      setChipActiveState(activeCategory);
      applyFilters("now");
      updateUrl("push");
    });
  });

  parkSelect.addEventListener("change", () => {
    applyFilters("now");
    updateUrl("push");
  });

  searchInput.addEventListener("input", () => {
    applyFilters("debounce");
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => updateUrl("replace"), 300);
  });

  window.addEventListener("popstate", () => {
    setFiltersFromUrl("none");
  });

  setFiltersFromUrl("replace");
</script>

<style>
  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--color-forest);
  }

  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    color: var(--color-muted);
    max-width: 60ch;
  }

  .filters {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.55);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .filter-row label {
    font-weight: 600;
    min-width: 4.5rem;
  }

  .chips {
    gap: 0.5rem;
  }

  .chip {
    border: 1px solid #c4b8a8;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .chip[data-active="true"] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }

  select,
  input[type="search"] {
    flex: 1;
    min-width: 200px;
    padding: 0.45rem 0.65rem;
    border: 1px solid #c4b8a8;
    border-radius: var(--radius);
    font: inherit;
    background: var(--color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-white);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .card.is-hidden,
  .card[hidden] {
    display: none !important;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    color: inherit;
  }

  .card img {
    width: 100%;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    background: #1a1a1a;
  }

  .card-body {
    padding: 0.85rem 1rem 1rem;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .meta {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: 2rem 0;
  }
</style>
