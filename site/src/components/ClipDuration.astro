---
import { formatDuration, formatDurationSpoken } from "../lib/format";

interface Props {
  durationSec: number;
}

const { durationSec } = Astro.props;
---

<time datetime={`PT${Math.round(durationSec)}S`}>
  <span class="sr-only">Duration: {formatDurationSpoken(durationSec)}</span>
  <span aria-hidden="true">{formatDuration(durationSec)}</span>
</time>
