---
import {
  FILTER_CATEGORY_INPUT_NAME,
  FILTER_IDS,
} from "../lib/filterController";
import type { Clip } from "../lib/catalog";

interface Props {
  clips: Clip[];
  categories: { name: string; count: number }[];
  parks: { code: string; name: string; count: number }[];
}

const { clips, categories, parks } = Astro.props;
---

<section
  id={FILTER_IDS.filters}
  class="filters"
  aria-labelledby={FILTER_IDS.filtersHeading}
>
  <div class="filters-header">
    <h2 id={FILTER_IDS.filtersHeading} class="filters-heading">Filter recordings</h2>
    <button
      type="button"
      id={FILTER_IDS.clearFilters}
      class="btn btn--secondary btn--small"
      hidden
    >
      Clear all filters
    </button>
  </div>

  <fieldset class="filter-row chips chip-fieldset">
    <legend class="filter-label">Category</legend>
    <div class="chip-group">
      <label class="chip">
        <input
          type="radio"
          name={FILTER_CATEGORY_INPUT_NAME}
          class="chip-input"
          value="all"
          checked
        />
        All ({clips.length})
      </label>
      {categories.map((cat) => (
        <label class="chip">
          <input
            type="radio"
            name={FILTER_CATEGORY_INPUT_NAME}
            class="chip-input"
            value={cat.name}
          />
          {cat.name} ({cat.count})
        </label>
      ))}
    </div>
  </fieldset>

  <div class="filter-row">
    <label for={FILTER_IDS.park}>Park</label>
    <select id={FILTER_IDS.park}>
      <option value="all">All parks ({clips.length})</option>
      {parks.map((park) => (
        <option value={park.code} data-park-name={park.name}>
          {park.name} ({park.code}) ({park.count})
        </option>
      ))}
    </select>
  </div>

  <div class="filter-row filter-row--search">
    <label for={FILTER_IDS.search}>Search</label>
    <div class="search-field">
      <input
        id={FILTER_IDS.search}
        type="search"
        placeholder="Search titles, parks, sites, descriptions…"
        autocomplete="off"
        aria-describedby={FILTER_IDS.searchHint}
      />
      <p id={FILTER_IDS.searchHint} class="filter-hint">
        Matches title, park, site, and description.
      </p>
    </div>
  </div>
</section>

<p
  id={FILTER_IDS.filterStatus}
  class="sr-only"
  aria-live="polite"
  aria-atomic="true"
></p>

<p id={FILTER_IDS.emptyState} class="empty-state" hidden>
  No recordings match your filters.
</p>

<script>
  import { initGalleryFilters } from "../lib/filterController";

  initGalleryFilters();
</script>

<style>
  .filters {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.55);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .filters-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .filters-heading {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-forest);
  }

  .btn--small {
    padding: 0.35rem 0.75rem;
    font-size: 0.85rem;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .filter-row label,
  .filter-label {
    font-weight: 600;
    min-width: 4.5rem;
    color: var(--color-brown-dark);
  }

  .filter-row--search {
    align-items: flex-start;
  }

  .search-field {
    flex: 1;
    min-width: 200px;
  }

  .filter-hint {
    margin: 0.35rem 0 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .chips {
    gap: 0.5rem;
  }

  .chip-fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .chip-fieldset .filter-label {
    padding: 0;
    margin: 0;
  }

  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .chip {
    position: relative;
    display: inline-block;
    border: 1px solid #c4b8a8;
    background: var(--color-white);
    color: var(--color-ink);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .chip:has(.chip-input:checked) {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }

  .chip:has(.chip-input:focus-visible) {
    outline: 2px solid var(--color-brown);
    outline-offset: 2px;
  }

  select,
  input[type="search"] {
    width: 100%;
    padding: 0.45rem 0.65rem;
    border: 1px solid #c4b8a8;
    border-radius: var(--radius);
    font: inherit;
    background: var(--color-white);
  }

  .empty-state {
    text-align: center;
    color: var(--color-muted);
    padding: 2rem 0;
  }
</style>
