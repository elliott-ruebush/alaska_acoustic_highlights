---
import type { Clip } from "../lib/catalog";
import { formatDuration } from "../lib/format";
import { withBase } from "../lib/paths";

interface Props {
  clip: Clip;
}

const { clip } = Astro.props;
const audioSrc = withBase(clip.audio_path);
const specSrc = withBase(clip.spectrogram_path);
const lowfreqSrc = clip.spectrogram_lowfreq_path ? withBase(clip.spectrogram_lowfreq_path) : null;
const durationLabel = formatDuration(clip.duration_sec);
const shortcutsId = `player-shortcuts-${clip.id}`;
---

<div
  id="audio-player"
  class="player"
  role="region"
  aria-label={`Audio player: ${clip.title}`}
  aria-describedby={shortcutsId}
  data-audio-src={audioSrc}
  data-duration={clip.duration_sec}
  data-spec-src={specSrc}
  data-lowfreq-src={lowfreqSrc ?? ""}
>
  <p class="player-status" aria-live="polite" aria-atomic="true"></p>

  <div class="waveform" aria-hidden="true"></div>

  <div class="spectrogram-frame" aria-label="Spectrogram — click to seek">
    <img
      src={specSrc}
      alt={`Spectrogram: ${clip.description}`}
      data-alt-full={`Spectrogram: ${clip.description}`}
      data-alt-low={lowfreqSrc ? `Low-frequency spectrogram: ${clip.description}` : undefined}
    />
    <div class="cursor" aria-hidden="true"></div>
  </div>

  <div class="controls">
    <button type="button" class="btn play-pause" aria-label="Play" aria-pressed="false" disabled>
      Play
    </button>

    <label class="seek-control">
      <span class="seek-label">Position</span>
      <input
        type="range"
        class="seek-slider"
        min="0"
        max={clip.duration_sec}
        value="0"
        step="1"
        disabled
        aria-valuemin="0"
        aria-valuemax={clip.duration_sec}
        aria-valuenow="0"
        aria-valuetext={`0:00 of ${durationLabel}`}
        aria-label="Playback position"
      />
      <span class="player-time" aria-hidden="true">
        <span class="time-elapsed">0:00</span>
        <span class="time-separator">/</span>
        <span class="time-total">{durationLabel}</span>
      </span>
    </label>

    {lowfreqSrc && (
      <button
        type="button"
        class="btn btn--secondary toggle-lowfreq"
        aria-pressed="false"
      >
        Show low-frequency view
      </button>
    )}

    <label class="volume-control">
      <span class="volume-label">Volume</span>
      <input
        type="range"
        class="volume-slider"
        min="0"
        max="100"
        value="50"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-label="Playback volume"
      />
    </label>
  </div>

  <p id={shortcutsId} class="player-shortcuts">
    Space: play/pause · ←/→: seek 5s · Shift+←/→: seek 30s · Home/End: start/end · M: mute
  </p>
</div>

<script>
  import WaveSurfer from "wavesurfer.js";
  import { formatDuration, handlePlayerKeydown } from "../lib/playerKeyboard";

  const VOLUME_STORAGE_KEY = "soundscapes-volume";
  const DEFAULT_VOLUME = 50;

  function readStoredVolume(): number {
    try {
      const raw = localStorage.getItem(VOLUME_STORAGE_KEY);
      if (raw === null) return DEFAULT_VOLUME;
      const value = Number.parseInt(raw, 10);
      if (Number.isNaN(value)) return DEFAULT_VOLUME;
      return Math.min(100, Math.max(0, value));
    } catch {
      return DEFAULT_VOLUME;
    }
  }

  document.querySelectorAll<HTMLElement>(".player").forEach((el) => {
    const audioSrc = el.dataset.audioSrc!;
    const fallbackDuration = parseFloat(el.dataset.duration || "0");
    const specSrc = el.dataset.specSrc!;
    const lowfreqSrc = el.dataset.lowfreqSrc || "";

    const statusEl = el.querySelector<HTMLElement>(".player-status")!;
    const waveformEl = el.querySelector<HTMLElement>(".waveform")!;
    const frame = el.querySelector<HTMLElement>(".spectrogram-frame")!;
    const img = frame.querySelector("img")!;
    const cursor = el.querySelector<HTMLElement>(".cursor")!;
    const playBtn = el.querySelector<HTMLButtonElement>(".play-pause")!;
    const lowfreqBtn = el.querySelector<HTMLButtonElement>(".toggle-lowfreq");
    const seekSlider = el.querySelector<HTMLInputElement>(".seek-slider")!;
    const timeElapsed = el.querySelector<HTMLElement>(".time-elapsed")!;
    const timeTotal = el.querySelector<HTMLElement>(".time-total")!;
    const volumeSlider = el.querySelector<HTMLInputElement>(".volume-slider")!;

    let isScrubbing = false;
    let lastAnnouncedSeek = -1;

    function getDuration(): number {
      return ws.getDuration() || fallbackDuration;
    }

    function announce(message: string) {
      statusEl.textContent = message;
    }

    function setPlayState(playing: boolean) {
      playBtn.textContent = playing ? "Pause" : "Play";
      playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
      playBtn.setAttribute("aria-pressed", String(playing));
    }

    function updateTimeDisplay() {
      const duration = getDuration();
      const current = Math.min(duration, Math.max(0, ws.getCurrentTime()));
      const elapsed = formatDuration(current);
      const total = formatDuration(duration);

      timeElapsed.textContent = elapsed;
      timeTotal.textContent = total;

      if (!isScrubbing) {
        seekSlider.value = String(Math.round(current));
        seekSlider.setAttribute("aria-valuenow", String(Math.round(current)));
        seekSlider.setAttribute("aria-valuetext", `${elapsed} of ${total}`);
      }
    }

    function updateCursor() {
      const duration = getDuration();
      const pct = duration ? (ws.getCurrentTime() / duration) * 100 : 0;
      cursor.style.left = `${Math.min(100, Math.max(0, pct))}%`;
      updateTimeDisplay();
    }

    function seekToTime(seconds: number, announceSeek = true) {
      const duration = getDuration();
      const clamped = Math.min(duration, Math.max(0, seconds));
      ws.setTime(clamped);
      updateCursor();

      if (announceSeek) {
        const rounded = Math.round(clamped);
        if (rounded !== lastAnnouncedSeek) {
          lastAnnouncedSeek = rounded;
          announce(`Seeked to ${formatDuration(clamped)}`);
        }
      }
    }

    function togglePlayPause() {
      ws.playPause();
    }

    function toggleMute() {
      const muted = !ws.getMuted();
      ws.setMuted(muted);
      announce(muted ? "Muted" : "Unmuted");
    }

    const ws = WaveSurfer.create({
      container: waveformEl,
      url: audioSrc,
      height: 48,
      cursorWidth: 0,
      waveColor: "#8a5a35",
      progressColor: "#1b3a2b",
      interact: false,
    });

    announce("Loading audio…");
    playBtn.disabled = true;
    seekSlider.disabled = true;

    function applyVolume(percent: number) {
      const clamped = Math.min(100, Math.max(0, percent));
      ws.setVolume(clamped / 100);
      volumeSlider.value = String(clamped);
      volumeSlider.setAttribute("aria-valuenow", String(clamped));
      if (clamped === 0) {
        ws.setMuted(true);
      } else if (ws.getMuted()) {
        ws.setMuted(false);
      }
    }

    applyVolume(readStoredVolume());

    volumeSlider.addEventListener("input", () => {
      const percent = Number.parseInt(volumeSlider.value, 10);
      applyVolume(percent);
      try {
        localStorage.setItem(VOLUME_STORAGE_KEY, String(percent));
      } catch {
        // ignore private browsing / storage errors
      }
    });

    seekSlider.addEventListener("pointerdown", () => {
      isScrubbing = true;
    });
    seekSlider.addEventListener("pointerup", () => {
      isScrubbing = false;
    });
    seekSlider.addEventListener("change", () => {
      isScrubbing = false;
    });
    seekSlider.addEventListener("input", () => {
      seekToTime(Number.parseFloat(seekSlider.value), true);
    });

    ws.on("audioprocess", updateCursor);
    ws.on("seeking", updateCursor);
    ws.on("timeupdate", updateCursor);
    ws.on("finish", () => {
      updateCursor();
      setPlayState(false);
      announce("Finished");
    });

    ws.on("play", () => {
      setPlayState(true);
      announce("Playing");
    });

    ws.on("pause", () => {
      setPlayState(false);
      announce("Paused");
    });

    ws.on("ready", () => {
      const duration = getDuration();
      const max = Math.max(1, Math.round(duration));
      seekSlider.max = String(max);
      seekSlider.setAttribute("aria-valuemax", String(max));
      timeTotal.textContent = formatDuration(duration);
      playBtn.disabled = false;
      seekSlider.disabled = false;
      statusEl.textContent = "";
      updateTimeDisplay();
    });

    ws.on("error", () => {
      playBtn.disabled = true;
      seekSlider.disabled = true;
      announce("Unable to load audio");
    });

    playBtn.addEventListener("click", () => togglePlayPause());

    frame.addEventListener("click", (e) => {
      const rect = frame.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      seekToTime(pct * getDuration());
    });

    if (lowfreqBtn && lowfreqSrc) {
      let showingLow = false;
      const altFull = img.dataset.altFull ?? img.alt;
      const altLow = img.dataset.altLow ?? altFull;

      lowfreqBtn.addEventListener("click", () => {
        showingLow = !showingLow;
        img.src = showingLow ? lowfreqSrc : specSrc;
        img.alt = showingLow ? altLow : altFull;
        lowfreqBtn.textContent = showingLow
          ? "Show full-range view"
          : "Show low-frequency view";
        lowfreqBtn.setAttribute("aria-pressed", String(showingLow));
      });
    }

    const keyActions = {
      togglePlayPause,
      seekBy: (deltaSec: number) => seekToTime(ws.getCurrentTime() + deltaSec),
      seekToStart: () => seekToTime(0),
      seekToEnd: () => seekToTime(getDuration()),
      toggleMute,
    };

    document.addEventListener("keydown", (e) => {
      handlePlayerKeydown(e, el, keyActions);
    });
  });
</script>

<style>
  .player {
    margin: 1.5rem 0;
  }

  .player-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .waveform {
    margin-bottom: 0.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(27, 58, 43, 0.06);
  }

  .spectrogram-frame {
    position: relative;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .spectrogram-frame img {
    width: 100%;
    display: block;
  }

  .cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-brown);
    pointer-events: none;
    left: 0%;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.35);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .seek-control {
    display: inline-flex;
    flex: 1 1 12rem;
    align-items: center;
    gap: 0.5rem;
    min-width: min(100%, 14rem);
    color: var(--color-brown-dark);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .seek-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .seek-slider {
    flex: 1;
    min-width: 6rem;
    accent-color: var(--color-brown);
    cursor: pointer;
  }

  .player-time {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .time-separator {
    margin: 0 0.15rem;
  }

  .volume-control {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    min-width: min(100%, 12rem);
    color: var(--color-brown-dark);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .volume-label {
    flex-shrink: 0;
  }

  .volume-slider {
    width: 8rem;
    max-width: 100%;
    accent-color: var(--color-brown);
    cursor: pointer;
  }

  .player-shortcuts {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .play-pause:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
</style>
